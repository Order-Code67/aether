{
  "name": "aether",
  "private": true,
  "version": "0.2.35",
  "description": "Modern IDE for robots, drones, and embedded systems",
  "type": "module",
  "workspaces": [
    "apps/bpla-studio",
    "apps/aether-configurator"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run src/lib/focusPolicy.test.ts src/lib/uploadGate.test.ts src/lib/supportReport.test.ts src/lib/pioErrors.test.ts src/lib/vscodeIntegration.test.ts src/lib/comDrivers.test.ts src/lib/serialPlotter.radio.test.ts src/lib/hardwarePinMaps.test.ts src/lib/distOffline.test.ts src/lib/radioSerialDoctor.test.ts src/lib/mspPlotter.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "studio:dev": "npm run tauri:dev -w bpla-studio",
    "studio:build": "npm run tauri:build -w bpla-studio",
    "configurator:dev": "npm run dev -w aether-configurator",
    "configurator:build": "npm run build -w aether-configurator",
    "configurator:package": "npm run package -w aether-configurator",
    "build:offline-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-offline-cache.ps1",
    "build:offline-libs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-offline-cache.ps1 -LibsOnly",
    "package:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-dist.ps1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.54.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
