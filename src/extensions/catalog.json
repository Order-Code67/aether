        "id": "community.pid-snippets",
        "name": "PID Control Snippets",
        "version": "0.1.0",
        "description": "Basic PID loop and setpoint clamp snippets for flight/robot control.",
        "publisher": "Community",
        "category": "snippets",
        "contributes": {
          "languages": ["cpp", "c"],
          "snippets": [
            {
              "label": "pidstep",
              "insertText": "float ${1:error} = ${2:setpoint} - ${3:measured};\n${4:integral} += ${1:error} * ${5:dt};\nfloat ${6:derivative} = (${1:error} - ${7:prevError}) / ${5:dt};\n${7:prevError} = ${1:error};\nfloat ${8:out} = ${9:kp} * ${1:error} + ${10:ki} * ${4:integral} + ${11:kd} * ${6:derivative};\n",
              "detail": "PID step"
            },
            {
              "label": "clampf",
              "insertText": "${1:value} = fminf(${2:max}, fmaxf(${3:min}, ${1:value}));",
              "detail": "Clamp float"
            }
          ]
        }
      }
